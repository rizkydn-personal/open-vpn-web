VPN_API_BASE_URL=http://127.0.0.1:8089
VPN_API_KEY=ganti-dengan-key-dari-server
# JSON array opsional untuk beberapa server. Jika diisi, ini menggantikan dua variabel di atas.
VPN_API_SERVERS=[{"id":"vm1","label":"Server 1","baseUrl":"https://api.example.com","apiKey":"ganti-key"}]
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
DAILY_LIMIT_PER_SERVICE=10
ALLOWED_DAYS=1,3,7
PER_IP_CREATE_LIMIT_PER_HOUR=5
PER_IP_CREATE_LIMIT_PER_DAY=3
# Pilih firestore atau memory. Kosong berarti Firestore bila semua FIREBASE_* diisi.
QUOTA_STORE=memory
# URL publik opsional untuk canonical dan metadata.
SITE_URL=
IP_HASH_SALT=ganti-dengan-string-acak-panjang
TRUST_PROXY_HEADERS=0
SUPPORT_URL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VPN_API_GET_TIMEOUT_MS=8000
VPN_API_POST_TIMEOUT_MS=20000
