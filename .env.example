# API Upstream URL and Key
VPN_API_BASE_URL="https://api.example.com"
VPN_API_KEY="your-upstream-api-key"

# Secret salt for IP Hashing (min 16 chars)
IP_HASH_SALT="change_this_to_a_random_long_string_1234567890"

# Quota Store configuration (memory or firestore)
QUOTA_STORE="memory"

# Rate limits
DAILY_LIMIT_PER_SERVICE="10"
PER_IP_CREATE_LIMIT_PER_DAY="3"
PER_IP_CREATE_LIMIT_PER_HOUR="5"

# Optional Cloudflare Turnstile
# TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Optional URL for Support/Donation
# SUPPORT_URL="https://example.com/donate"

# Site URL for metadata
# SITE_URL="https://vpn.example.com"

# Firestore configuration (if QUOTA_STORE is firestore)
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""